# Copia este archivo a `.env.local` y rellena con los valores del panel de Supabase:
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANON

# Solo para el script scripts/upload-local-manga.mjs (nunca NEXT_PUBLIC_ ni commits públicos)
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Bucket donde se suben las viñetas (debe existir en Storage; por defecto comic-pages)
# COMIC_STORAGE_BUCKET=comic-pages

# --- Auth (Supabase Dashboard → Authentication → URL configuration) ---
# Site URL: http://localhost:3000 (dev) o tu dominio en producción
# Redirect URLs (añadir todas las que uses):
#   http://localhost:3000/auth/callback
#   https://TU-PROYECTO.vercel.app/auth/callback
# Habilitar proveedores: Authentication → Providers → Email, Google (Client ID / Secret de Google Cloud Console)

# Google Analytics 4 (gtag). Opcional: cadena vacía desactiva el script en ese entorno.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-WPRV0WYBBS

# Google AdSense (ca-pub-…). Opcional: cadena vacía desactiva el script en ese entorno.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-4094870352712876

# URL canónica del sitio (recomendada para SEO / enlaces absolutos en producción).
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
